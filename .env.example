# ============================================================================
# Tavus -- required for live interviews
# ============================================================================
# 1. Sign up / log in at https://platform.tavus.io (free tier available, no
#    credit card required for testing).
# 2. Get an API key from the PAL Maker dashboard: https://maker.tavus.io/dev
#    -> "API Key" in the sidebar -> "Create New Key".
TAVUS_API_KEY=

# 3. A replica is the AI interviewer's face + voice. Use a stock replica
#    from your dashboard, or create your own at https://platform.tavus.io/replicas
#    (Your previous project used replica id r9d30b0e55ac -- it may still be
#    valid on your account; verify it in the dashboard before relying on it.)
TAVUS_REPLICA_ID=

# Optional: if you've built a Persona in Tavus's PAL Maker (custom LLM/voice
# config), you can use its ID here instead of, or alongside, a replica ID.
TAVUS_PERSONA_ID=

# ============================================================================
# OpenAI -- optional, unlocks AI-written coaching feedback
# ============================================================================
# Without this, the app still runs full local sentiment/emotion analysis and
# competency tagging -- it just uses a rule-based summary instead of an
# AI-written one, and skips per-answer coaching notes.
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# App
# ============================================================================
HOST=127.0.0.1
PORT=5000
DEFAULT_INTERVIEW_SECONDS=300
